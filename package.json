{
  "name": "memosebui",
  "version": "0.1.0",
  "description": "Interactive force-directed memory graph and desktop interface for memoseb within the *seb ecosystem",
  "keywords": [
    "memosebui",
    "memoseb",
    "hubseb",
    "crewseb",
    "deckseb",
    "knowledge-graph",
    "vector-memory",
    "tauri"
  ],
  "license": "MIT",
  "author": "PahesebPJ",
  "homepage": "https://github.com/PahesebPJ/memosebui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PahesebPJ/memosebui.git"
  },
  "bugs": {
    "url": "https://github.com/PahesebPJ/memosebui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "memosebui": "./dist/cli/memosebui.js"
  },
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "AGENT_INSTALL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"if (fs.existsSync('dist/cli/memosebui.js')) fs.chmodSync('dist/cli/memosebui.js', 0o755)\"",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.spec.ts\"",
    "memosebui": "node src/cli/memosebui.ts",
    "ui": "node src/cli/memosebui.ts ui"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
