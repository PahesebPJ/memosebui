{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memosebui",
  "version": "../package.json",
  "identifier": "com.paheseb.memosebui",
  "build": {
    "beforeDevCommand": "npm run build:sidecar",
    "beforeBuildCommand": "npm run build:sidecar",
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Visor neuronal de la memoria de memoseb",
    "longDescription": "Grafo interactivo, búsqueda y gestión de las memorias de memoseb para el ecosistema *seb.",
    "externalBin": ["binaries/memosebui-server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
